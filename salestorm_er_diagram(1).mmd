---
title: SALESTORM Flash Sale - Entity Relationship Diagram
---
erDiagram
    %% =====================================================================
    %% RELATIONSHIPS, ordered along the purchase pipeline
    %% Customer > Discovery > Cart > Reservation > Order > Payment > Shipment > Notification
    %% =====================================================================

    %% Customer and catalogue
    CUSTOMER ||--o{ ADDRESS : "has"
    CATEGORY |o--o{ CATEGORY : "parent of"
    CATEGORY ||--o{ PRODUCT : "classifies"

    %% Flash sale pricing and promotions
    SALE ||--o{ SALE_ITEM : "features"
    PRODUCT ||--o{ SALE_ITEM : "offered in"
    DEAL |o--o{ SALE_ITEM : "prices"
    COUPON ||--o{ COUPON_REDEMPTION : "redeemed as"
    ORDER ||--o{ COUPON_REDEMPTION : "applies"

    %% Cart
    CUSTOMER ||--o{ CART : "owns"
    CART ||--o{ CART_ITEM : "contains"
    PRODUCT ||--o{ CART_ITEM : "added as"

    %% Inventory and reservation (contention-critical)
    PRODUCT ||--o| INVENTORY : "stocked as"
    INVENTORY ||--o{ INVENTORY_RESERVATION : "reserves from"
    CUSTOMER ||--o{ INVENTORY_RESERVATION : "holds"
    SALE_ITEM |o--o{ INVENTORY_RESERVATION : "reserved under"
    INVENTORY ||--o{ INVENTORY_LEDGER : "audited by"
    INVENTORY_RESERVATION |o--o{ INVENTORY_LEDGER : "recorded in"

    %% Checkout and order
    CUSTOMER ||--o{ ORDER : "places"
    CART |o--o{ ORDER : "checked out as"
    ADDRESS ||--o{ ORDER : "ships to"
    ORDER ||--|{ ORDER_ITEM : "contains"
    PRODUCT ||--o{ ORDER_ITEM : "sold as"
    INVENTORY_RESERVATION ||--o| ORDER_ITEM : "converted to"
    ORDER ||--o{ ORDER_STATUS_HISTORY : "traced by"

    %% Payment
    ORDER ||--o{ PAYMENT : "paid by"
    PAYMENT ||--o{ REFUND : "refunded by"

    %% Fulfilment and notification
    ORDER ||--o{ SHIPMENT : "fulfilled by"
    SHIPMENT ||--o{ SHIPMENT_TRACKING_EVENT : "tracked by"
    CUSTOMER ||--o{ NOTIFICATION : "receives"
    ORDER |o--o{ NOTIFICATION : "triggers"

    %% Platform tables (these lines are references by id only, not foreign keys)
    ORDER |o--o{ OUTBOX_EVENT : "emits"
    PAYMENT |o--o{ OUTBOX_EVENT : "emits"
    INVENTORY_RESERVATION |o--o{ OUTBOX_EVENT : "emits"
    OUTBOX_EVENT ||--o{ PROCESSED_EVENT : "consumed once per consumer"
    ORDER |o--o{ AUDIT_LOG : "audited in"
    PAYMENT |o--o{ AUDIT_LOG : "audited in"
    INVENTORY_RESERVATION |o--o{ AUDIT_LOG : "audited in"

    %% =====================================================================
    %% ENTITIES, grouped by owning service, with why each group exists
    %% =====================================================================

    %% === IDENTITY: who is buying. ADDRESS rows are immutable once an order uses them (an edit creates a new row).
    CUSTOMER {
        uuid customer_id PK
        string email UK
        string phone UK
        string full_name
        enum status "ACTIVE, BLOCKED"
        timestamp created_at
        timestamp updated_at
    }

    ADDRESS {
        uuid address_id PK
        uuid customer_id FK
        string line1
        string line2
        string city
        string state
        string postal_code
        string country_code
        boolean is_default
        timestamp created_at
    }

    %% === PRODUCT: read-heavy catalogue for discovery, safe to cache and serve through the CDN.
    CATEGORY {
        uuid category_id PK
        uuid parent_category_id FK "nullable, self reference"
        string name
        string slug UK
    }

    PRODUCT {
        uuid product_id PK
        uuid category_id FK
        string sku UK
        string name
        string description
        bigint base_price_minor "minor units, e.g. paise"
        string currency_code
        enum status "DRAFT, ACTIVE, ARCHIVED"
        timestamp created_at
        timestamp updated_at
    }

    %% === SALE AND PROMOTION: time-boxed flash-sale pricing and discount rules, read-heavy while the sale is live.
    SALE {
        uuid sale_id PK
        string name
        timestamp starts_at
        timestamp ends_at
        enum status "SCHEDULED, LIVE, ENDED"
    }

    DEAL {
        uuid deal_id PK
        string name
        enum deal_type "PERCENT_OFF, FLAT_OFF, FIXED_PRICE"
        bigint discount_value "percent or paise"
        timestamp valid_from
        timestamp valid_to
    }

    SALE_ITEM {
        uuid sale_item_id PK
        uuid sale_id FK
        uuid product_id FK
        uuid deal_id FK "nullable"
        bigint sale_price_minor
        int per_customer_limit
    }

    COUPON {
        uuid coupon_id PK
        string code UK
        enum discount_type "PERCENT, FLAT"
        bigint discount_value
        bigint min_order_minor
        int max_redemptions
        int redeemed_count
        timestamp valid_from
        timestamp valid_to
        enum status "ACTIVE, EXPIRED, DISABLED"
    }

    COUPON_REDEMPTION {
        uuid redemption_id PK
        uuid coupon_id FK
        uuid order_id FK
        bigint discount_minor
        timestamp redeemed_at
    }

    %% === CART: shopping intent only. A cart item holds no claim on stock.
    CART {
        uuid cart_id PK
        uuid customer_id FK
        enum status "ACTIVE, CHECKED_OUT, ABANDONED"
        timestamp created_at
        timestamp updated_at
    }

    CART_ITEM {
        uuid cart_item_id PK
        uuid cart_id FK
        uuid product_id FK
        int quantity
        timestamp added_at
    }

    %% === INVENTORY AND RESERVATION: system of record for stock.
    %% INVENTORY is the contention point, INVENTORY_RESERVATION is a time-boxed claim on stock,
    %% INVENTORY_LEDGER is the append-only proof that the counters are right.
    INVENTORY {
        uuid inventory_id PK
        uuid product_id FK, UK
        int total_quantity "available + reserved + sold"
        int available_quantity "never below 0"
        int reserved_quantity "never below 0"
        int sold_quantity "never below 0"
        bigint version "bumped on every change"
        timestamp updated_at
    }

    INVENTORY_RESERVATION {
        uuid reservation_id PK
        uuid inventory_id FK
        uuid customer_id FK
        uuid sale_item_id FK "nullable"
        int quantity "must be above 0"
        enum status "RESERVED, PAYMENT_PENDING, CONFIRMED, SOLD, PAYMENT_FAILED, TIMEOUT, RELEASED"
        string idempotency_key UK "duplicate Buy Now guard"
        timestamp reserved_at
        timestamp expires_at "TTL, expiry sweeper releases"
        timestamp released_at
        string release_reason "PAYMENT_FAILED, TIMEOUT, CANCELLED"
        bigint version
    }

    INVENTORY_LEDGER {
        bigint ledger_id PK
        uuid inventory_id FK
        uuid reservation_id FK "nullable"
        enum movement_type "RESERVE, RELEASE, SELL, RESTOCK, ADJUST"
        int delta_available
        int delta_reserved
        int delta_sold
        bigint version_after
        string trace_id
        timestamp created_at
    }

    %% === ORDER: business record of the purchase. ORDER_ITEM.reservation_id ties each line to its stock claim.
    ORDER {
        uuid order_id PK
        uuid customer_id FK
        uuid cart_id FK "nullable, Buy Now skips the cart"
        uuid shipping_address_id FK
        enum status "CREATED, PAYMENT_PENDING, CONFIRMED, PROCESSING, SHIPPED, OUT_FOR_DELIVERY, DELIVERED, CANCELLED"
        string cancel_reason "PAYMENT_FAILED, RESERVATION_EXPIRED, CUSTOMER"
        bigint subtotal_minor
        bigint discount_minor
        bigint total_minor
        string currency_code
        string idempotency_key UK "duplicate checkout guard"
        bigint version "optimistic lock"
        timestamp created_at
        timestamp updated_at
    }

    ORDER_ITEM {
        uuid order_item_id PK
        uuid order_id FK
        uuid product_id FK
        uuid reservation_id FK, UK "one reservation, one order line"
        int quantity
        bigint unit_price_minor "price snapshot"
        bigint line_total_minor
    }

    ORDER_STATUS_HISTORY {
        bigint history_id PK
        uuid order_id FK
        enum from_status
        enum to_status
        string reason
        string changed_by "service or user"
        string trace_id
        timestamp changed_at
    }

    %% === PAYMENT: money movement, kept apart from order logic so gateway state, retries and refunds stay isolated.
    PAYMENT {
        uuid payment_id PK
        uuid order_id FK
        string provider_code "gateway adapter key"
        enum method "CARD, UPI, NETBANKING, WALLET"
        bigint amount_minor
        string currency_code
        enum status "INITIATED, PENDING, SUCCEEDED, FAILED, TIMED_OUT"
        string idempotency_key UK "duplicate payment guard"
        string transaction_ref UK "our unique reference sent to the gateway"
        string gateway_txn_id UK "nullable, issued by the gateway"
        string failure_code
        int attempt_count
        bigint version "optimistic lock"
        timestamp initiated_at
        timestamp completed_at
    }

    REFUND {
        uuid refund_id PK
        uuid payment_id FK
        bigint amount_minor
        string reason "compensation, cancellation"
        enum status "REQUESTED, SUCCEEDED, FAILED"
        string idempotency_key UK
        string gateway_refund_id UK
        timestamp requested_at
        timestamp completed_at
    }

    %% === SHIPMENT: fulfilment and delivery tracking.
    SHIPMENT {
        uuid shipment_id PK
        uuid order_id FK
        string carrier_code "delivery partner adapter key"
        string tracking_number UK
        enum status "PENDING, PACKED, SHIPPED, OUT_FOR_DELIVERY, DELIVERED, FAILED"
        timestamp shipped_at
        timestamp estimated_delivery_at
        timestamp delivered_at
    }

    SHIPMENT_TRACKING_EVENT {
        bigint tracking_event_id PK
        uuid shipment_id FK
        string status
        string location
        timestamp event_time
    }

    %% === NOTIFICATION: customer messages, deduplicated per event and channel.
    NOTIFICATION {
        uuid notification_id PK
        uuid customer_id FK
        uuid order_id FK "nullable"
        string event_type "e.g. ORDER_CONFIRMED"
        enum channel "EMAIL, SMS, PUSH"
        enum status "PENDING, SENT, FAILED"
        string dedupe_key UK "one message per event and channel"
        int retry_count
        timestamp created_at
        timestamp sent_at
    }

    %% === PLATFORM: transactional outbox (reliable publish), inbox (idempotent consume) and audit trail.
    %% These have no foreign keys on purpose. A row points at one of several tables (aggregate_type + aggregate_id,
    %% entity_type + entity_id) or at an event produced elsewhere, and a foreign key can only target one table.
    %% The lines to these tables show references by id, not foreign keys. For AUDIT_LOG only the three audited aggregates are drawn;
    %% any entity may appear in it.
    OUTBOX_EVENT {
        uuid event_id PK
        string aggregate_type "ORDER, PAYMENT, RESERVATION"
        uuid aggregate_id
        string event_type "e.g. PaymentSucceeded"
        json payload
        enum status "PENDING, PUBLISHED, FAILED"
        int attempt_count
        string trace_id
        timestamp created_at
        timestamp published_at
    }

    PROCESSED_EVENT {
        string consumer_name PK
        uuid event_id PK
        timestamp processed_at
    }

    AUDIT_LOG {
        bigint audit_id PK
        string entity_type
        uuid entity_id
        string action
        string actor "user or service"
        json details
        string trace_id
        timestamp created_at
    }

    %% =====================================================================
    %% DESIGN NOTES (comments, not rendered): what the diagram cannot draw
    %% =====================================================================

    %% [NOTATION]
    %% PK primary key, FK foreign key, UK unique constraint. Composite and partial constraints are listed below.
    %% Lines to OUTBOX_EVENT, PROCESSED_EVENT and AUDIT_LOG are references by id only, with no foreign key.
    %% Money is stored as integer minor units (paise) in *_minor columns. All timestamps are UTC.
    %% Quoted text after a column gives allowed enum values or a rule. Transitions belong in the state diagrams.

    %% [SERVICE OWNERSHIP] each service owns its tables. Lines that cross a service boundary are ID references
    %% validated by API or event, not cross-database foreign keys, which keeps coupling low.
    %% The platform tables are different: the target table varies per row, or the id belongs to an event produced
    %% elsewhere, so a foreign key is impossible even inside one database.
    %% Identity: CUSTOMER, ADDRESS | Product: CATEGORY, PRODUCT | Cart: CART, CART_ITEM
    %% Sale/Promotion: SALE, DEAL, SALE_ITEM, COUPON, COUPON_REDEMPTION
    %% Inventory and Reservation: INVENTORY, INVENTORY_RESERVATION, INVENTORY_LEDGER
    %% Order: ORDER, ORDER_ITEM, ORDER_STATUS_HISTORY | Payment: PAYMENT, REFUND
    %% Shipment: SHIPMENT, SHIPMENT_TRACKING_EVENT | Notification: NOTIFICATION
    %% Platform (one copy per service): OUTBOX_EVENT, PROCESSED_EVENT, AUDIT_LOG

    %% [CONCURRENCY CONTROL] where overselling is prevented
    %% The contention point is ONE atomic conditional UPDATE on the product's INVENTORY row:
    %%     UPDATE inventory
    %%        SET available_quantity = available_quantity - :q,
    %%            reserved_quantity  = reserved_quantity  + :q,
    %%            version = version + 1, updated_at = now()
    %%      WHERE product_id = :p AND available_quantity >= :q
    %% 1 row updated = units reserved. 0 rows updated = out of stock and nothing else is written.
    %% The row lock lasts only for this short transaction, so contenders queue for milliseconds instead of retrying.
    %% CHECK constraints are the last line of defence: the database itself refuses a negative available_quantity.
    %% 'version' rises on every change. It drives optimistic checks on ORDER, PAYMENT and RESERVATION and ties each
    %% ledger row to the counter state (version_after). It is deliberately NOT the gate for the hot inventory row,
    %% because optimistic retries from thousands of losers would multiply the load.

    %% [TRANSACTION BOUNDARIES AND CONSISTENCY]
    %% Strong consistency exists inside one service database. Across services the model is eventually consistent
    %% through OUTBOX_EVENT (publish) and PROCESSED_EVENT (idempotent consume). No distributed transactions.
    %% T1 Reserve (Inventory DB, one local transaction)
    %%    check idempotency_key, run the conditional UPDATE above, INSERT reservation (RESERVED, expires_at = now + TTL),
    %%    INSERT ledger (RESERVE), INSERT outbox (ReservationCreated), COMMIT.
    %%    A unique violation on idempotency_key rolls everything back, so a duplicate click never takes a second unit.
    %% T2 Create order (Order DB): INSERT order (CREATED), ORDER_ITEM (reservation_id), history row, outbox (OrderCreated).
    %% T3 Start payment (Payment DB): INSERT payment (INITIATED, idempotency_key, transaction_ref) BEFORE calling the
    %%    gateway. Order and reservation then move to PAYMENT_PENDING through events.
    %% T4 Settle payment (Payment DB): UPDATE payment WHERE status IN (INITIATED, PENDING, TIMED_OUT), INSERT outbox
    %%    (PaymentSucceeded or PaymentFailed). A gateway timeout leaves TIMED_OUT, resolved by querying the gateway
    %%    with transaction_ref, so a retry cannot create a second charge.
    %% T5 Confirm order (Order DB): INSERT processed_event (a repeat is skipped), UPDATE order PAYMENT_PENDING -> CONFIRMED
    %%    guarded by status, INSERT history, INSERT outbox (OrderConfirmed). If the Order Service is down,
    %%    PaymentSucceeded waits in the broker, is retried with backoff, then dead-lettered. A reconciliation job
    %%    finds PAYMENT SUCCEEDED with ORDER still PAYMENT_PENDING and replays it.
    %% T6 Commit stock (Inventory DB): PaymentSucceeded -> reservation CONFIRMED. OrderConfirmed -> SOLD with
    %%    reserved_quantity - q, sold_quantity + q, ledger (SELL).
    %% T7 Release stock (Inventory DB): PaymentFailed or the expiry sweeper -> reservation RELEASED with
    %%    reserved_quantity - q, available_quantity + q, ledger (RELEASE). Guarded by status, so it is idempotent
    %%    and never touches CONFIRMED or SOLD. A reservation with an unresolved TIMED_OUT payment is released only
    %%    after reconciliation shows the payment was not captured.
    %% Late payment: PaymentSucceeded for an already RELEASED reservation -> order CANCELLED and a REFUND is raised.

    %% [CONSTRAINTS]
    %% INVENTORY: UNIQUE (product_id); CHECK (available_quantity >= 0 AND reserved_quantity >= 0 AND sold_quantity >= 0);
    %%     CHECK (available_quantity + reserved_quantity + sold_quantity = total_quantity)
    %% INVENTORY_RESERVATION: UNIQUE (idempotency_key); CHECK (quantity > 0); CHECK (status IN the listed values);
    %%     partial UNIQUE (customer_id, sale_item_id) WHERE status IN (RESERVED, PAYMENT_PENDING, CONFIRMED, SOLD)
    %%     enforces one unit per customer when per_customer_limit = 1; higher limits are counted inside T1
    %% ORDER_ITEM: UNIQUE (reservation_id) so one reservation can become at most one order line
    %% ORDER: UNIQUE (idempotency_key)
    %% PAYMENT: UNIQUE (idempotency_key); UNIQUE (transaction_ref); UNIQUE (gateway_txn_id) where not null;
    %%     partial UNIQUE (order_id) WHERE status = 'SUCCEEDED' so an order has at most one successful payment
    %% SALE_ITEM UNIQUE (sale_id, product_id) | CART_ITEM UNIQUE (cart_id, product_id) | COUPON_REDEMPTION UNIQUE (coupon_id, order_id)
    %% NOTIFICATION UNIQUE (dedupe_key) | PROCESSED_EVENT PK (consumer_name, event_id)
    %% Every FK uses ON DELETE RESTRICT: financial and stock records are never cascaded away.

    %% [INDEXES beyond PK and UK]
    %% INVENTORY_RESERVATION (status, expires_at) for the expiry sweeper; (inventory_id, status) for reconciliation sums
    %% ORDER (customer_id, created_at); ORDER (status, updated_at) to find orders stuck in PAYMENT_PENDING
    %% PAYMENT (order_id); PAYMENT (status, initiated_at) to reconcile INITIATED, PENDING and TIMED_OUT payments
    %% OUTBOX_EVENT (status, created_at) for the relay; INVENTORY_LEDGER (inventory_id, created_at)
    %% ORDER_STATUS_HISTORY (order_id, changed_at); SHIPMENT (order_id); NOTIFICATION (customer_id, created_at)
    %% Every FK column not covered above gets a plain index to keep joins and ON DELETE checks cheap.

    %% [INVARIANTS] checked by a reconciliation job; any violation raises an alert
    %% I1 available_quantity + reserved_quantity + sold_quantity = total_quantity, and none is negative
    %% I2 reserved_quantity = SUM(quantity) of reservations that are not yet SOLD or RELEASED
    %% I3 sold_quantity = SUM(quantity) of reservations in SOLD
    %% I4 per inventory row, the SUM of ledger deltas = current counters (initial stock is an ADJUST entry)
    %% I5 at most one SUCCEEDED payment per order and at most one order line per reservation

    %% [AUDIT AND TRACEABILITY]
    %% INVENTORY_LEDGER (stock movements), ORDER_STATUS_HISTORY (order lifecycle) and AUDIT_LOG (who did what) are
    %% append-only: never UPDATE or DELETE. Each carries a trace_id to follow one purchase across checkout, payment
    %% and order. PAYMENT and REFUND changes are written to AUDIT_LOG in the same transaction as the change.

    %% [BOTTLENECK AND SCALE-OUT]
    %% Likely bottleneck: the single INVENTORY row of a flash-sale product, because every reservation serializes on it.
    %% At 50x traffic: reject or queue excess requests before they reach the database, keep reads (catalogue, sale
    %% pricing) on cache and replicas, and if one row is still too hot, split stock into N bucket rows per product
    %% (bucket quantities sum to total_quantity), pick a bucket by hash(customer_id) and try the next when one is empty.
    %% Partition INVENTORY, INVENTORY_RESERVATION and ORDER by product_id or customer_id; ledger and history
    %% tables are append-only and partition by time.

    %% [SCENARIO CHECK] Product X, total_quantity = 100, 10,000 Buy Now clicks, 95% payment success
    %% step                                  available  reserved  sold
    %% start                                     100        0       0
    %% 100 requests win the UPDATE                 0      100       0    (9,900 get out-of-stock, 0 rows updated)
    %% 95 payments succeed                         0        5      95
    %% 5 payments fail, units released             5        0      95    (freed units can be reserved again)
    %% 5 later requests reserve and pay            0        0     100
    %% The 2% duplicate clicks reuse their reservation through idempotency_key, so they consume no extra units.
    %% available + reserved + sold = 100 after every step, so sold can never exceed 100.
